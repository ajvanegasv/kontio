# ==============================================================================
# Kontio - .gitignore (Kotlin Multiplatform: Android & iOS)
# ==============================================================================

# ------------------------------------------------------------------------------
# Gradle & Build Artifacts
# ------------------------------------------------------------------------------
.gradle/
build/
**/build/
!src/**/build/
gradle-app.setting
.gradletasknamecache
*.hprof

# Preserve Gradle Wrapper jar
!gradle/wrapper/gradle-wrapper.jar

# ------------------------------------------------------------------------------
# Kotlin & Native (Kotlin/Native & Kotlin/JS)
# ------------------------------------------------------------------------------
.kotlin/
.konan/
kotlin-js-store/

# ------------------------------------------------------------------------------
# Android
# ------------------------------------------------------------------------------
# SDK / NDK paths and local device configs
local.properties

# Android build outputs & caches
captures/
.externalNativeBuild/
.cxx/
output.json
*.apk
*.aab
*.ap_
*.dex

# Keystores and signing credentials (DO NOT COMMIT)
*.jks
*.keystore
signing.properties
secrets.properties
private.pem

# Google Services / Firebase (sensitive credentials)
google-services.json

# ------------------------------------------------------------------------------
# iOS & Xcode
# ------------------------------------------------------------------------------
# Xcode user-specific data & state
xcuserdata/
*.xcuserdatad/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
DerivedData/

# Xcode project files (preserve shared project structure, ignore user-specific settings)
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
!*.xcodeproj/project.xcworkspace/
!*.xcworkspace/contents.xcworkspacedata
**/xcshareddata/WorkspaceSettings.xcsettings

# CocoaPods & SPM
Pods/
.build/
Packages/
*.xcworkspace/xcuserdata

# Fastlane outputs & iOS signing
*.mobileprovision
*.provisionprofile
*.cer
*.p12
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/
fastlane/test_output/

# Firebase iOS credentials
GoogleService-Info.plist

# ------------------------------------------------------------------------------
# IDEs & Editors
# ------------------------------------------------------------------------------
# Android Studio / IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws
out/
.shelf/

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/

# Fleet
.fleet/

# ------------------------------------------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example

# ------------------------------------------------------------------------------
# Operating System Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ------------------------------------------------------------------------------
# Miscellaneous & Logs
# ------------------------------------------------------------------------------
*.log
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
